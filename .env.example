# Copy to .env and export the variables you need. Every setting has a safe default.
BG_HOST=127.0.0.1
BG_PORT=8000
# ":memory:" loses data on restart. Use a file path to persist content, users, audit log and the signing key.
BG_DB_PATH=:memory:
# Demo mode enables the sign-in switcher and the Hallucination Trap simulator. Set to 0 for anything real.
BG_DEMO=1
BG_KB_PATH=data/demo_brand.json
# Optional: enables the AI judge. Without it only exact checks run.
# ANTHROPIC_API_KEY=
# BG_MODEL=claude-sonnet-5-5
# Optional: fixes the receipt signing key. If unset, one is generated and stored in the database.
# BG_SIGNING_KEY=
BG_MAX_BODY_BYTES=1000000
BG_MAX_TEXT_CHARS=50000
BG_RATE_LIMIT_PER_MINUTE=240
BG_MIN_SAMPLES=5
BG_HEALTH_THRESHOLD=0.4
